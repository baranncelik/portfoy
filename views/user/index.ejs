          <div class="content-area">
            <div class="animated-sections">
              <!-- Home Subpage -->
<section data-id="home" class="animated-section start-page section-active">
                <style>
                  /* Temanın gizleme kurallarını Home için ezme */
                  .start-page,
                  .start-page.section-active {
                    position: relative !important;
                    visibility: visible !important;
                    opacity: 1 !important;
                    display: flex !important;
                    overflow: hidden;
                    height: 100vh;
                    min-height: -webkit-fill-available;
                    width: 100%;
                    align-items: center;
                    justify-content: center;
                    top: 0;
                    left: 0;
                    transition: background 2.5s ease-in-out;
                    z-index: 1;
                  }

                  /* --- MEVSİM GÖKYÜZÜ VE ARKA PLANLARI --- */
                  .start-page.season-winter { background: #07101c !important; }
                  .start-page.season-spring { background: linear-gradient(to bottom, #6cbde7 0%, #b8e994 100%) !important; }
                  .start-page.season-summer { background: linear-gradient(to bottom, #1f78b4 0%, #5cbfe8 50%, #f8df9e 100%) !important; }
                  .start-page.season-autumn { background: linear-gradient(to bottom, #1a202c 0%, #334155 50%, #4a3325 100%) !important; }

                  /* Şimşek Efekti (Sonbahar) */
                  .lightning-flash {
                    position: absolute;
                    inset: 0;
                    background: rgba(255, 255, 255, 0.88);
                    opacity: 0;
                    pointer-events: none;
                    z-index: 15;
                  }
                  .season-autumn .lightning-flash {
                    animation: lightning 7s infinite;
                  }

                  /* Yaz Güneşi, Denizi ve Sörfçü */
                  .summer-sun {
                    position: absolute;
                    top: clamp(25px, 6vh, 60px);
                    left: 50%;
                    transform: translateX(-50%);
                    width: clamp(70px, 8vw, 100px);
                    height: clamp(70px, 8vw, 100px);
                    border-radius: 50%;
                    background: radial-gradient(circle, #fff7ad, #ffa502);
                    box-shadow: 0 0 50px #ffa502, 0 0 90px #ff7f50;
                    display: none;
                    z-index: 1;
                    animation: sunPulse 4s infinite alternate;
                  }
                  .season-summer .summer-sun { display: block; }

                  .summer-sea {
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 100%;
                    height: clamp(70px, 12vh, 120px);
                    display: none;
                    z-index: 2;
                    overflow: hidden;
                  }
                  .season-summer .summer-sea { display: block; }

                  .wave {
                    position: absolute;
                    bottom: 0;
                    width: 200%;
                    height: 60%;
                    background: rgba(0, 140, 240, 0.45);
                    border-radius: 40% 40% 0 0;
                    animation: waveMove 6s linear infinite;
                  }
                  .wave:nth-child(2) {
                    bottom: 8px;
                    background: rgba(0, 95, 190, 0.6);
                    animation: waveMove 4s linear infinite reverse;
                  }

                  .surfer-container {
                    position: absolute;
                    bottom: 25px;
                    left: -90px;
                    display: none;
                    z-index: 3;
                    animation: surfRide 13s linear infinite;
                  }
                  .season-summer .surfer-container { display: block; }

                  /* İlkbahar Uçan Kuşlar */
                  .birds-container {
                    position: absolute;
                    top: 14%;
                    right: -100px;
                    display: none;
                    z-index: 3;
                    animation: birdsFly 14s linear infinite;
                  }
                  .season-spring .birds-container { display: block; }

                  /* --- 2.5D DOĞAL TEPELİ ZEMİN (ORGANİK SVG) --- */
                  .season-ground-svg {
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 100%;
                    height: clamp(65px, 10vh, 95px);
                    z-index: 3;
                    pointer-events: none;
                  }
                  .ground-path-back, .ground-path-front {
                    transition: fill 2s ease;
                  }

                  .season-winter .ground-path-back { fill: #c4dbe6; }
                  .season-winter .ground-path-front { fill: #eef7fb; }
                  .season-spring .ground-path-back { fill: #27ae60; }
                  .season-spring .ground-path-front { fill: #2ecc71; }
                  .season-summer .ground-path-back { fill: #d35400; }
                  .season-summer .ground-path-front { fill: #f39c12; }
                  .season-autumn .ground-path-back { fill: #78281f; }
                  .season-autumn .ground-path-front { fill: #b9461e; }

                  /* --- SAHNE VE ELEMANLAR --- */
                  .stage-elements {
                    position: absolute;
                    inset: 0;
                    z-index: 4;
                    pointer-events: none;
                  }

                  /* Sol: Ev */
                  .cozy-houses-wrapper {
                    position: absolute;
                    bottom: clamp(20px, 4vh, 38px);
                    left: clamp(20px, 4vw, 60px);
                    width: clamp(190px, 20vw, 260px);
                    aspect-ratio: 220 / 190;
                  }

                  .house-svg {
                    width: 100%;
                    height: 100%;
                    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.7));
                  }

                  .house-door {
                    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
                    transform-origin: 145px center;
                  }
                  .door-open {
                    transform: perspective(400px) rotateY(-80deg);
                  }

                  .chimney-smoke {
                    position: absolute;
                    top: 14%;
                    left: 77%;
                    width: 14px;
                    height: 14px;
                  }
                  .smoke-puff {
                    position: absolute;
                    width: 12px;
                    height: 12px;
                    background: rgba(230, 245, 255, 0.45);
                    border-radius: 50%;
                    filter: blur(3.5px);
                    animation: smokeRise 4s infinite ease-out;
                  }
                  .smoke-puff:nth-child(2) { animation-delay: 1.3s; }
                  .smoke-puff:nth-child(3) { animation-delay: 2.6s; }

                  /* İlkbahar Ağacı */
                  .spring-extra-tree {
                    position: absolute;
                    bottom: clamp(30px, 5vh, 48px);
                    left: clamp(230px, 26vw, 360px);
                    width: clamp(90px, 10vw, 130px);
                    aspect-ratio: 140 / 190;
                    display: none;
                    opacity: 0.9;
                  }
                  .season-spring .spring-extra-tree { display: block; }

                  /* Kardan Adam */
                  .snowman-container {
                    position: absolute;
                    bottom: clamp(25px, 4.5vh, 40px);
                    right: clamp(180px, 22vw, 300px);
                    width: clamp(45px, 5vw, 65px);
                    aspect-ratio: 70 / 100;
                    display: none;
                  }
                  .season-winter .snowman-container { display: block; }

                  /* Sağ: Ağaç ve Salıncak */
                  .tree-wrapper {
                    position: absolute;
                    bottom: clamp(15px, 3vh, 30px);
                    right: clamp(15px, 3vw, 45px);
                    width: clamp(220px, 24vw, 320px);
                    aspect-ratio: 280 / 360;
                  }

                  .tree-svg {
                    width: 100%;
                    height: 100%;
                    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.65));
                  }

                  .tire-swing {
                    transform-origin: 135px 158px;
                    animation: tireSway 5s ease-in-out infinite alternate;
                  }
                  .season-autumn .tire-swing {
                    animation-duration: 2.8s;
                  }

                  /* Mevsimlik Süsler */
                  .snow-decor { display: none; }
                  .season-winter .snow-decor { display: inline; }

                  .spring-foliage { display: none; }
                  .season-spring .spring-foliage { display: inline; fill: #ff9ff3; opacity: 0.9; }
                  .season-summer .spring-foliage { display: inline; fill: #2ed573; opacity: 0.9; }
                  .season-autumn .spring-foliage { display: inline; fill: #d35400; opacity: 0.85; }

                  /* --- KOŞAN ÇOCUK --- */
                  .running-child {
                    position: absolute;
                    bottom: clamp(20px, 4vh, 36px);
                    width: clamp(26px, 2.5vw, 34px);
                    height: clamp(42px, 4.2vw, 54px);
                    z-index: 5;
                    pointer-events: none;
                    animation: runDirectlyToDoor 15s linear forwards;
                  }

                  .child-torso {
                    position: absolute;
                    top: 28%;
                    left: 30%;
                    width: 40%;
                    height: 36%;
                    background: #e74c3c;
                    border-radius: 4px;
                  }
                  .child-head {
                    position: absolute;
                    top: 6%;
                    left: 28%;
                    width: 44%;
                    aspect-ratio: 1;
                    background: #ffeaa7;
                    border-radius: 50%;
                  }
                  .child-cap {
                    position: absolute;
                    top: 0;
                    left: 24%;
                    width: 52%;
                    height: 14%;
                    background: #0984e3;
                    border-radius: 6px 6px 0 0;
                  }
                  .leg {
                    position: absolute;
                    top: 62%;
                    width: 14%;
                    height: 38%;
                    background: #2d3436;
                    transform-origin: top center;
                  }
                  .leg-left {
                    left: 30%;
                    animation: legCycle 0.35s infinite alternate ease-in-out;
                  }
                  .leg-right {
                    left: 55%;
                    animation: legCycle 0.35s infinite alternate-reverse ease-in-out;
                  }
                  .arm {
                    position: absolute;
                    top: 32%;
                    width: 10%;
                    height: 28%;
                    background: #e74c3c;
                    transform-origin: top center;
                  }
                  .arm-left {
                    left: 20%;
                    animation: legCycle 0.35s infinite alternate-reverse ease-in-out;
                  }
                  .arm-right {
                    left: 70%;
                    animation: legCycle 0.35s infinite alternate ease-in-out;
                  }

                  @keyframes runDirectlyToDoor {
                    0% {
                      right: clamp(140px, 16vw, 210px);
                      left: auto;
                      opacity: 1;
                    }
                    92% {
                      right: calc(100% - clamp(20px, 4vw, 60px) - (clamp(190px, 20vw, 260px) * 0.78));
                      opacity: 1;
                      transform: scale(1);
                    }
                    97% {
                      right: calc(100% - clamp(20px, 4vw, 60px) - (clamp(190px, 20vw, 260px) * 0.72));
                      opacity: 0.9;
                      transform: scale(0.85);
                    }
                    100% {
                      right: calc(100% - clamp(20px, 4vw, 60px) - (clamp(190px, 20vw, 260px) * 0.68));
                      opacity: 0;
                      transform: scale(0.7);
                    }
                  }

                  @keyframes legCycle {
                    0% { transform: rotate(-35deg); }
                    100% { transform: rotate(35deg); }
                  }

                  /* --- PARÇACIKLAR --- */
                  .season-particle {
                    position: absolute;
                    pointer-events: none;
                    user-select: none;
                    z-index: 6;
                  }

                  @keyframes particleSnow {
                    0% { transform: translateY(-20px) translateX(0) rotate(0deg); opacity: 0; }
                    20% { opacity: 0.9; }
                    100% { transform: translateY(105vh) translateX(30px) rotate(360deg); opacity: 0.2; }
                  }

                  @keyframes particleRain {
                    0% { transform: translateY(-30px) translateX(0); opacity: 1; }
                    100% { transform: translateY(105vh) translateX(-40px); opacity: 0.4; }
                  }

                  @keyframes particleLeaf {
                    0% { transform: translate(0, -20px) rotate(0deg); opacity: 1; }
                    50% { transform: translate(60px, 50vh) rotate(180deg); }
                    100% { transform: translate(-40px, 105vh) rotate(360deg); opacity: 0; }
                  }

                  @keyframes sunPulse {
                    from { transform: translateX(-50%) scale(0.95); box-shadow: 0 0 35px #ffa502; }
                    to { transform: translateX(-50%) scale(1.05); box-shadow: 0 0 75px #ff7f50; }
                  }
                  @keyframes waveMove {
                    0% { transform: translateX(0); }
                    100% { transform: translateX(-50%); }
                  }
                  @keyframes surfRide {
                    0% { left: -90px; transform: translateY(0) rotate(5deg); }
                    25% { transform: translateY(-10px) rotate(-4deg); }
                    50% { transform: translateY(8px) rotate(6deg); }
                    75% { transform: translateY(-8px) rotate(-3deg); }
                    100% { left: 105%; transform: translateY(0) rotate(5deg); }
                  }
                  @keyframes birdsFly {
                    0% { right: -120px; top: 12%; }
                    100% { right: 105%; top: 22%; }
                  }
                  @keyframes lightning {
                    0%, 94%, 98%, 100% { opacity: 0; }
                    95%, 97% { opacity: 0.95; }
                  }
                  @keyframes smokeRise {
                    0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
                    25% { opacity: 0.65; }
                    100% { transform: translate(-30px, -70px) scale(2.6); opacity: 0; }
                  }
                  @keyframes tireSway {
                    0% { transform: rotate(-6deg); }
                    100% { transform: rotate(8deg); }
                  }

                  /* Başlık ve Metin Katmanı */
                  .title-block {
                    position: relative;
                    z-index: 10;
                    text-align: center;
                    padding: 1rem;
                    width: 100%;
                    max-width: 90%;
                    margin: 0 auto;
                  }
                  .title-block h2 {
                    font-size: clamp(2rem, 6.5vw, 4.4rem);
                    font-weight: 800;
                    margin: 0 0 0.8rem;
                    color: #fff;
                    text-shadow: 0 0 20px rgba(0,0,0,0.65);
                  }
                  .typewriter {
                    color: #fff;
                    font-size: clamp(1rem, 3.2vw, 1.8rem);
                    font-weight: 600;
                    font-family: 'Courier New', monospace;
                    position: relative;
                    width: max-content;
                    margin: 0 auto;
                    text-shadow: 0 0 10px rgba(0,0,0,0.85);
                  }
                  .typewriter::after {
                    content: '|';
                    position: absolute;
                    right: -8px;
                    width: 8px;
                    animation: blink 0.75s step-end infinite;
                  }
                  @keyframes blink {
                    0%, 100% { opacity: 1; }
                    50% { opacity: 0; }
                  }

                  /* --- MOBİL İNCE AYARLAR (768px ve altı) --- */
                  @media (max-width: 768px) {
                    .start-page {
                      height: 100svh !important;
                      min-height: 100svh !important;
                    }
                    .spring-extra-tree {
                      display: none !important;
                    }
                    .cozy-houses-wrapper {
                      left: 4px;
                      bottom: 20px;
                      width: 140px;
                    }
                    .tree-wrapper {
                      right: 4px;
                      bottom: 15px;
                      width: 150px;
                    }
                    .snowman-container {
                      right: 95px;
                      bottom: 20px;
                      width: 40px;
                      transform: scale(0.68);
                    }
                    .chimney-smoke {
                      top: 10%;
                      left: 75%;
                    }
                    .running-child {
                      bottom: 20px;
                      transform: scale(0.65);
                      animation: runDirectlyToDoorMobile 15s linear forwards !important;
                    }

                    @keyframes runDirectlyToDoorMobile {
                      0% {
                        right: 40px;
                        left: auto;
                        opacity: 1;
                      }
                      92% {
                        right: calc(100% - 124px);
                        opacity: 1;
                        transform: scale(0.65);
                      }
                      97% {
                        right: calc(100% - 114px);
                        opacity: 0.9;
                        transform: scale(0.55);
                      }
                      100% {
                        right: calc(100% - 104px);
                        opacity: 0;
                        transform: scale(0.45);
                      }
                    }
                  }
                </style>

                <!-- Şimşek (Sonbahar) -->
                <div class="lightning-flash"></div>

                <!-- Yaz Güneşi, Denizi ve Sörfçü -->
                <div class="summer-sun"></div>
                <div class="summer-sea">
                  <div class="wave"></div>
                  <div class="wave"></div>
                </div>
                <div class="surfer-container">
                  <svg width="65" height="55" viewBox="0 0 70 60" fill="none">
                    <path d="M5 52 Q 35 44 65 52 Q 35 56 5 52 Z" fill="#ff4757" stroke="#fff" stroke-width="1.5" />
                    <circle cx="34" cy="12" r="5" fill="#f1c40f" />
                    <path d="M34 17 L 31 32 L 23 46" stroke="#2f3542" stroke-width="3" stroke-linecap="round" />
                    <path d="M31 32 L 42 46" stroke="#2f3542" stroke-width="3" stroke-linecap="round" />
                    <path d="M33 22 L 20 20" stroke="#f1c40f" stroke-width="2.5" stroke-linecap="round" />
                    <path d="M33 22 L 48 24" stroke="#f1c40f" stroke-width="2.5" stroke-linecap="round" />
                  </svg>
                </div>

                <!-- İlkbahar Uçan Kuşlar -->
                <div class="birds-container">
                  <svg width="120" height="40" viewBox="0 0 120 40">
                    <path d="M10 20 Q 20 10 30 20 Q 40 10 50 20" stroke="#2c3e50" stroke-width="2.5" fill="none" />
                    <path d="M60 12 Q 67 4 75 12 Q 82 4 90 12" stroke="#2c3e50" stroke-width="2" fill="none" />
                    <path d="M95 24 Q 102 18 110 24 Q 117 18 125 24" stroke="#2c3e50" stroke-width="2" fill="none" />
                  </svg>
                </div>

                <!-- Parçacık Kutusu -->
                <div id="particle-box"></div>

                <!-- Sahne Elemanları -->
                <div class="stage-elements">
                  <!-- Ev (Sol) -->
                  <div class="cozy-houses-wrapper">
                    <div class="chimney-smoke">
                      <div class="smoke-puff"></div>
                      <div class="smoke-puff"></div>
                      <div class="smoke-puff"></div>
                    </div>

                    <svg class="house-svg" viewBox="0 0 220 190" fill="none">
                      <rect x="165" y="32" width="18" height="42" fill="#121820" />
                      <rect class="snow-decor" x="162" y="29" width="24" height="6" fill="#eaf4f7" rx="2" />
                      <polygon points="40,95 200,95 190,185 50,185" fill="#141c24" />
                      <polygon points="25,100 120,38 215,100" fill="#0d131a" />
                      <path class="snow-decor" d="M22 102 Q 75 58 120 38 Q 165 58 218 102 Q 165 86 120 50 Q 75 86 22 102 Z" fill="#f0f8fa" />

                      <rect x="70" y="118" width="34" height="34" rx="3" fill="#ffb703" />
                      <line x1="87" y1="118" x2="87" y2="152" stroke="#141c24" stroke-width="2.5" />
                      <line x1="70" y1="135" x2="104" y2="135" stroke="#141c24" stroke-width="2.5" />
                      <rect class="snow-decor" x="67" y="115" width="40" height="4" rx="2" fill="#f0f8fa" />

                      <!-- Kapı Boşluğu ve Açılır Kapı -->
                      <rect x="145" y="128" width="28" height="57" rx="2" fill="#ff9f43" />
                      <rect class="house-door" id="front-door" x="145" y="128" width="28" height="57" rx="2" fill="#84593c" />
                      <circle cx="151" cy="157" r="2.2" fill="#ffbe76" />
                    </svg>
                  </div>

                  <!-- İlkbahar Pembe Ağaç -->
                  <div class="spring-extra-tree">
                    <svg viewBox="0 0 140 190" fill="none">
                      <path d="M70 190 L 70 110 L 45 80 M 70 110 L 95 75" stroke="#3d2c1f" stroke-width="8" stroke-linecap="round" />
                      <circle cx="45" cy="70" r="28" fill="#ffb8b8" opacity="0.85" />
                      <circle cx="95" cy="65" r="30" fill="#ff9ff3" opacity="0.85" />
                      <circle cx="70" cy="48" r="25" fill="#f368e0" opacity="0.75" />
                    </svg>
                  </div>

                  <!-- Kış Kardan Adamı -->
                  <div class="snowman-container">
                    <svg viewBox="0 0 70 100" fill="none">
                      <circle cx="35" cy="70" r="22" fill="#ffffff" />
