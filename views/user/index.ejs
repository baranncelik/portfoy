                  <div class="row">
                    <div class="col-sm-12">
                      <div class="title-block">
                        <h2 class="dynamic-text">BARAN ÇELİK</h2>
                        <div class="typewriter"></div>
                      </div>
                    </div>
                  </div>
                </div>

                <script>
                  (function() {
                    const seasons = ['season-winter', 'season-spring', 'season-summer', 'season-autumn'];

                    function getInitialSeasonByDate() {
                      const month = new Date().getMonth();
                      if (month === 11 || month === 0 || month === 1) return 0; // Kış
                      if (month >= 2 && month <= 4) return 1;                  // İlkbahar
                      if (month >= 5 && month <= 7) return 2;                  // Yaz
                      return 3;                                                // Sonbahar
                    }

                    let currentSeasonIdx = getInitialSeasonByDate();
                    let cycleTimeoutA = null;
                    let cycleTimeoutB = null;
                    let typeWriterInterval = null;
                    let isCycleRunning = false;

                    function getElements() {
                      return {
                        section: document.querySelector('.start-page'),
                        particleBox: document.getElementById('particle-box'),
                        door: document.getElementById('front-door'),
                        child: document.getElementById('child'),
                        typewriter: document.querySelector('.typewriter')
                      };
                    }

                    function updateParticles(seasonClass) {
                      const els = getElements();
                      if (!els.particleBox) return;
                      els.particleBox.innerHTML = '';
                      const isMobile = window.innerWidth < 768;
                      const count = isMobile ? 18 : 36;

                      if (seasonClass === 'season-winter') {
                        const snowSymbols = ['❄', '❅', '•'];
                        for (let i = 0; i < count; i++) {
                          const p = document.createElement('div');
                          p.className = 'season-particle';
                          p.textContent = snowSymbols[Math.floor(Math.random() * snowSymbols.length)];
                          p.style.color = '#fff';
                          p.style.fontSize = (Math.random() * 12 + 10) + 'px';
                          p.style.left = Math.random() * 100 + '%';
                          p.style.top = '-20px';
                          p.style.animation = `particleSnow ${Math.random() * 4 + 4}s linear infinite`;
                          p.style.animationDelay = (Math.random() * 5) + 's';
                          els.particleBox.appendChild(p);
                        }
                      } else if (seasonClass === 'season-spring') {
                        for (let i = 0; i < Math.floor(count / 2); i++) {
                          const p = document.createElement('div');
                          p.className = 'season-particle';
                          p.textContent = '🌸';
                          p.style.fontSize = (Math.random() * 12 + 10) + 'px';
                          p.style.left = Math.random() * 100 + '%';
                          p.style.top = '-20px';
                          p.style.animation = `particleLeaf ${Math.random() * 6 + 5}s ease-in-out infinite`;
                          p.style.animationDelay = (Math.random() * 5) + 's';
                          els.particleBox.appendChild(p);
                        }
                      } else if (seasonClass === 'season-autumn') {
                        for (let i = 0; i < count; i++) {
                          const rain = document.createElement('div');
                          rain.className = 'season-particle';
                          rain.style.width = '2px';
                          rain.style.height = (Math.random() * 15 + 15) + 'px';
                          rain.style.background = 'rgba(174, 194, 214, 0.7)';
                          rain.style.left = Math.random() * 100 + '%';
                          rain.style.top = '-20px';
                          rain.style.animation = `particleRain ${Math.random() * 0.8 + 0.6}s linear infinite`;
                          rain.style.animationDelay = (Math.random() * 2) + 's';
                          els.particleBox.appendChild(rain);
                        }
                        const leafIcons = ['🍂', '🍁'];
                        const leafCount = isMobile ? 8 : 14;
                        for (let i = 0; i < leafCount; i++) {
                          const leaf = document.createElement('div');
                          leaf.className = 'season-particle';
                          leaf.textContent = leafIcons[Math.floor(Math.random() * leafIcons.length)];
                          leaf.style.fontSize = (Math.random() * 14 + 12) + 'px';
                          leaf.style.left = Math.random() * 100 + '%';
                          leaf.style.top = '-20px';
                          leaf.style.animation = `particleLeaf ${Math.random() * 4 + 4}s ease-in-out infinite`;
                          leaf.style.animationDelay = (Math.random() * 5) + 's';
                          els.particleBox.appendChild(leaf);
                        }
                      }
                    }

                    function startSeasonCycle() {
                      const els = getElements();
                      if (!els.section) return;

                      clearTimeout(cycleTimeoutA);
                      clearTimeout(cycleTimeoutB);

                      seasons.forEach(s => els.section.classList.remove(s));
                      els.section.classList.add(seasons[currentSeasonIdx]);
                      updateParticles(seasons[currentSeasonIdx]);

                      // Çocuk koşu animasyonunu resetle ve başlat
                      if (els.child) {
                        els.child.style.animation = 'none';
                        els.child.offsetHeight; /* reflow */
                        const isMobile = window.innerWidth < 768;
                        els.child.style.animation = `${isMobile ? 'runDirectlyToDoorMobile' : 'runDirectlyToDoor'} 15s linear forwards`;
                      }

                      cycleTimeoutA = setTimeout(() => {
                        if (els.door) els.door.classList.add('door-open');
                      }, 13500);

                      cycleTimeoutB = setTimeout(() => {
                        if (els.door) els.door.classList.remove('door-open');
                        currentSeasonIdx = (currentSeasonIdx + 1) % seasons.length;
                        startSeasonCycle();
                      }, 15000);

                      isCycleRunning = true;
                    }

                    function typeWriter(element, text, i = 0) {
                      if (!element) return;
                      if (i === 0) {
                        element.textContent = '';
                        element.style.opacity = '1';
                      }
                      if (i < text.length) {
                        element.textContent += text.charAt(i);
                        setTimeout(() => typeWriter(element, text, i + 1), 100);
                      }
                    }

                    function initTypewriter() {
                      const els = getElements();
                      if (!els.typewriter) return;
                      const titles = ['Computer Engineer', 'Full-Stack Developer'];
                      let currentTitle = 0;

                      function updateTitle() {
                        typeWriter(els.typewriter, titles[currentTitle]);
                        currentTitle = (currentTitle + 1) % titles.length;
                      }

                      if (typeWriterInterval) clearInterval(typeWriterInterval);
                      updateTitle();
                      typeWriterInterval = setInterval(updateTitle, 4000);
                    }

                    function launchHero() {
                      startSeasonCycle();
                      initTypewriter();
                    }

                    // 1. Standart Yükleme Tetikleyicileri
                    if (document.readyState === 'complete' || document.readyState === 'interactive') {
                      setTimeout(launchHero, 100);
                    } else {
                      document.addEventListener('DOMContentLoaded', () => setTimeout(launchHero, 100));
                    }

                    window.addEventListener('load', launchHero);

                    // 2. Hash / Sayfa Değişim Dinleyicisi
                    window.addEventListener('hashchange', () => {
                      if (window.location.hash === '#home' || window.location.hash === '') {
                        launchHero();
                      }
                    });

                    // 3. LMPixels Animating Subpages Mutation Observer (Mobilde temanın JS'ini yakalar)
                    const targetSection = document.querySelector('section[data-id="home"]');
                    if (targetSection) {
                      const observer = new MutationObserver((mutations) => {
                        mutations.forEach((mutation) => {
                          if (mutation.attributeName === 'class') {
                            const isHomeActive = targetSection.classList.contains('section-active');
                            if (isHomeActive && !isCycleRunning) {
                              launchHero();
                            }
                          }
                        });
                      });
                      observer.observe(targetSection, { attributes: true });
                    }
                  })();
                </script>
              </section>
<!-- End of Home Subpage -->
              <!-- End of Home Subpage -->

