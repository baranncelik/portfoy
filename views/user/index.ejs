                <style>
                  .start-page {
                    position: relative;
                    overflow: hidden;
                    background: #000;
                    height: 100vh;
                    width: 100%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    position: absolute;
                    top: 0;
                    left: 0;
                  }

                  /* Volkanik Arka Plan Animasyonu */
                  .volcanic-bg {
                    position: absolute;
                    inset: 0;
                    z-index: 1;
                    background: 
                      radial-gradient(circle at 50% 150%, #ff4d4d 0%, transparent 35%),
                      radial-gradient(circle at 30% 100%, #ff8533 0%, transparent 45%),
                      radial-gradient(circle at 70% 100%, #ff6600 0%, transparent 45%);
                    filter: blur(60px);
                    opacity: 0;
                    animation: fadeInBg 2s ease forwards, glow 8s ease-in-out infinite alternate;
                  }

                  .particle {
                    position: absolute;
                    width: 4px;
                    height: 4px;
                    background: #ff3300;
                    border-radius: 50%;
                    animation: rise 3s infinite;
                    opacity: 0;
                  }

                  /* Ana İçerik Stili */
                  .title-block {
                    position: relative;
                    z-index: 2;
                    text-align: center;
                    padding: 2rem;
                    width: 100%;
                    max-width: 90%;
                    margin: 0 auto;
                    opacity: 0;
                    transform: translateY(30px);
                    animation: slideUpFade 1s ease forwards;
                    animation-delay: 0.5s;
                  }

                  .title-block h2 {
                    font-size: clamp(2.5rem, 8vw, 4.5rem);
                    font-weight: 800;
                    margin: 0 0 1rem;
                    color: #fff;
                    text-shadow: 
                      0 0 10px rgba(255,69,0,0.5),
                      0 0 20px rgba(255,69,0,0.3);
                    opacity: 0;
                    transform: scale(0.9);
                    animation: popIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                    animation-delay: 1s;
                  }

                  .typewriter {
                    color: #ff6b4a;
                    font-size: clamp(1.2rem, 4vw, 1.8rem);
                    font-weight: 600;
                    font-family: 'Courier New', monospace;
                    position: relative;
                    width: max-content;
                    margin: 0 auto;
                    opacity: 0;
                    animation: fadeIn 0.5s forwards;
                    animation-delay: 1.5s;
                  }

                  .typewriter::after {
                    content: '|';
                    position: absolute;
                    right: -8px;
                    width: 8px;
                    color: #ff6b4a;
                    animation: blink 0.75s step-end infinite;
                  }

                  /* Animasyonlar */
                  @keyframes fadeInBg {
                    from { opacity: 0; }
                    to { opacity: 0.4; }
                  }

                  @keyframes rise {
                    0% {
                      transform: translateY(100vh) scale(0);
                      opacity: 1;
                    }
                    60% {
                      opacity: 1;
                    }
                    100% {
                      transform: translateY(-20vh) scale(1);
                      opacity: 0;
                    }
                  }

                  @keyframes glow {
                    0% {
                      filter: blur(60px) brightness(1);
                    }
                    50% {
                      filter: blur(60px) brightness(1.3);
                    }
                    100% {
                      filter: blur(60px) brightness(1);
                    }
                  }

                  @keyframes popIn {
                    0% {
                      opacity: 0;
                      transform: scale(0.9);
                    }
                    50% {
                      opacity: 1;
                      transform: scale(1.05);
                    }
                    100% {
                      opacity: 1;
                      transform: scale(1);
                    }
                  }

                  @keyframes slideUpFade {
                    to {
                      opacity: 1;
                      transform: translateY(0);
                    }
                  }

                  @keyframes blink {
                    0%, 100% { opacity: 1; }
                    50% { opacity: 0; }
                  }

                  /* Responsive Tasarım */
                  @media (max-width: 768px) {
                    .start-page {
                      padding: 1rem;
                    }
                    
                    .title-block {
                      padding: 1.5rem;
                    }

                    .volcanic-bg {
                      background: 
                        radial-gradient(circle at 50% 150%, #ff4d4d 0%, transparent 45%),
                        radial-gradient(circle at 30% 100%, #ff8533 0%, transparent 55%),
                        radial-gradient(circle at 70% 100%, #ff6600 0%, transparent 55%);
                    }

                    .particle {
                      width: 3px;
                      height: 3px;
                    }
                  }

                  @media (max-width: 480px) {
                    .title-block {
                      padding: 1rem;
                    }

                    .typewriter {
                      font-size: 1.1rem;
                    }

                    .particle {
                      width: 2px;
                      height: 2px;
                    }
                  }

                  /* Performans İyileştirmeleri */
                  @media (prefers-reduced-motion: reduce) {
                    .volcanic-bg,
                    .particle,
                    .title-block,
                    .title-block h2,
                    .typewriter {
                      animation: none;
                      opacity: 1;
                      transform: none;
                    }
                  }
                </style>

