                          var honeypot = document.getElementById("form_hp_check");
                          var warningBox = document.getElementById("spam-warning");

                          var pageLoadedAt = Date.now();
                          var COOLDOWN_SECONDS = 120; // Başarılı gönderimden sonra 2 dakika bekleme

                          function showWarning(text) {
                            if (warningBox) {
                              warningBox.textContent = text;
                              warningBox.style.display = "block";
                            }
                          }

                          // 1. Daha önce gönderilmişse bekleme süresini kontrol et
                          function checkExistingCooldown() {
                            var lastSent = localStorage.getItem("last_msg_sent_time");
                            if (lastSent) {
                              var elapsed = Math.floor((Date.now() - parseInt(lastSent, 10)) / 1000);
                              if (elapsed < COOLDOWN_SECONDS) {
                                lockButton(COOLDOWN_SECONDS - elapsed);
                              }
                            }
                          }

                          // 2. Butonu kilitleyip sayaç başlat
                          function lockButton(remaining) {
                            btn.disabled = true;
                            btn.style.opacity = "0.6";
                            btn.style.cursor = "not-allowed";

                            var timer = setInterval(function () {
                              btn.value = "Wait " + remaining + "s";
                              remaining--;

                              if (remaining < 0) {
                                clearInterval(timer);
                                btn.disabled = false;
                                btn.style.opacity = "1";
                                btn.style.cursor = "pointer";
                                btn.value = "Send message";
                                localStorage.removeItem("last_msg_sent_time");
                                if (warningBox) warningBox.style.display = "none";
                              }
                            }, 1000);
                          }

                          // Sayfa açıldığında cooldown var mı bak
                          checkExistingCooldown();

                          // 3. Form Gönderim Anı Kontrolleri
                          form.addEventListener("submit", function (e) {
                            // KONTROL A: Honeypot (Bot alanı doldurmuş mu?)
                            if (honeypot && honeypot.value.trim() !== "") {
                              e.preventDefault();
                              console.warn("Spam Bot tespit edildi (Honeypot). Form iptal edildi.");
                              return false;
                            }

                            // KONTROL B: İnsan hızı kontrolü (3 saniyeden hızlı atan bottur)
                            var timeSpent = Date.now() - pageLoadedAt;
                            if (timeSpent < 3000) {
                              e.preventDefault();
                              showWarning("Please take your time to fill the form properly.");
                              return false;
                            }

                            // KONTROL C: Bekleme süresi aktif mi?
                            var lastSent = localStorage.getItem("last_msg_sent_time");
                            if (lastSent) {
                              var elapsed = Math.floor((Date.now() - parseInt(lastSent, 10)) / 1000);
                              if (elapsed < COOLDOWN_SECONDS) {
                                e.preventDefault();
                                showWarning("You must wait before sending another message.");
                                return false;
                              }
                            }

                            // Her şey geçerliyse:
                            // Son gönderim anını kaydet (2 dakika bekleme süresini başlat)
                            localStorage.setItem("last_msg_sent_time", Date.now().toString());

                            // Çift tıklamayı engellemek için butonu anında devre dışı bırak
                            btn.disabled = true;
                            btn.value = "Sending...";
                          });
                        })();
                      </script>
                    </div>
                    <!-- End of Contact Form -->
