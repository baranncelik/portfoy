<!DOCTYPE html>
<html lang="tr" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge"> 
    <title><%= posts.title %> | Baran Çelik ' s Blog</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="description" content="<%= posts.summary %>" />
    <meta name="keywords" content="Baran Çelik, blog, yazılım, teknoloji, web geliştirme, <%= posts.title %>" />
    <meta name="author" content="Baran Çelik" />
    <link rel="shortcut icon" href="favicon.ico">


    <link rel="stylesheet" href="/  css/reset.css" type="text/css">
    <link rel="stylesheet" href="/css/bootstrap-grid.min.css" type="text/css">
    <link rel="stylesheet" href="/css/animations.css" type="text/css">
    <link rel="stylesheet" href="/css/perfect-scrollbar.css" type="text/css">
    <link rel="stylesheet" href="/css/main.css" type="text/css">
    <link rel="stylesheet" href="/css/blog-post.css" type="text/css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

  </head>

  <body>
    <!-- Animated Background -->
    <div class="lm-animated-bg" style="background-image: url(/img/main_bg.png);"></div>
    <!-- /Animated Background -->

    <!-- Loading animation -->
    <div class="preloader">
      <div class="preloader-animation">
        <div class="preloader-spinner">
        </div>
      </div>
    </div>
    <!-- /Loading animation -->

    <div class="page">
      <div class="page-content">
          <header id="site_header" class="header mobile-menu-hide">
            <div class="header-content">
              <div class="header-photo">
                <img src="<%= settings.profile_photo %>" alt="Baran Çelik">
              </div>
              <div class="header-titles">
                <h2>Baran Çelik</h2>
                <h4>Computer Engineer & Full-Stack Developer</h4>
              </div>
            </div>

            <ul class="main-menu">
              <li class="active">
                <a href="/#home" class="nav-anim">
                  <span class="menu-icon lnr lnr-home"></span>
                  <span class="link-text">Home</span>
                </a>
              </li>
              <li>
                <a href="/#about-me" class="nav-anim">
                  <span class="menu-icon lnr lnr-user"></span>
                  <span class="link-text">About Me</span>
                </a>
              </li>
              <li>
                <a href="/#resume" class="nav-anim">
                  <span class="menu-icon lnr lnr-graduation-hat"></span>
                  <span class="link-text">Resume</span>
                </a>
              </li>
              <li>
                <a href="/#project" class="nav-anim">
                  <span class="menu-icon lnr lnr-briefcase"></span>
                  <span class="link-text">Projects</span>
                </a>
              </li>
              <li>
                <a href="/#blog" class="nav-anim">
                  <span class="menu-icon lnr lnr-book"></span>
                  <span class="link-text">Blog</span>
                </a>
              </li>
              <li>
                <a href="/#contact" class="nav-anim">
                  <span class="menu-icon lnr lnr-envelope"></span>
                  <span class="link-text">Contact</span>
                </a>
              </li>
            </ul>

            <div class="social-links">
              <ul>
                <li><a href="https://www.linkedin.com/in/baranncelik/" target="_blank"><i class="fab fa-linkedin-in"></i></a></li>
                <li><a href="https://www.instagram.com/baran_celikj/" target="_blank"><i class="fab fa-instagram -i"></i></a></li>
                <li><a href="https://github.com/baranncelik" target="_blank"><i class="fab fa-github"></i></a></li>
              </ul>
            </div>

            <div class="header-buttons">
              <a href="<%= settings.cv %>" target="_blank" class="btn btn-primary">Download CV</a>
            </div>

            <div class="copyrights">© 2025 All rights reserved by Baran Çelik.</div>
          </header>

          <!-- Mobile Navigation -->
          <div class="menu-toggle">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <!-- End Mobile Navigation -->


    <%
    // Basit tarih formatlayıcı
    function prettyDate(dt){
      if(!dt) return '';
      const d = new Date(dt);
      if (isNaN(d)) return dt;
      return d.toLocaleDateString(undefined, { year:'numeric', month:'short', day:'numeric' });
    }
    %>

    <style>
/* Mobil: entry/content/share - basit, düzgün, ortalı, border yok */
@media (max-width:767px){
  .content-area.single-page-area{
    padding:.75rem;
    background:#fff;
  }

  .single-page-content{
    max-width:720px;
    margin:0 auto;
    padding:0;
    text-align:center; /* container ortalansın */
    background-color: white; /* Arka plan rengi white olarak ayarlandı */
  }

  .post-hero{
    display:block;
    margin:0 0 .75rem;
  }
  
  .post-content {
    background-color: white; /* Post content arka planı white yapıldı */
  }



  .hero-image{
    width:100%;
    height:100%;
    object-fit:cover;
    border-radius:12px;
    display:block;
    margin:0 auto;
  }

  .hero-overlay{
    position:absolute;
    inset:0;
    height:220px;
    pointer-events:none;
    border-radius:12px;
    background:linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,0));
  }

  .hero-content{
    padding:.5rem 0 0;
    position:relative;
    z-index:2;
    text-align:center;
  }

  .hero-meta .hero-date{
    font-size:.85rem;
    color:rgba(15,23,42,.6);
    display:block;
    margin:.25rem 0;
  }

  .entry-header .entry-title{
    font-size:1.18rem;
    line-height:1.28;
    margin:.4rem 0 .6rem;
    font-weight:700;
    color:#0f172a;
    text-align:center;
  }

  .project-info-grid{
    display:block;
    margin:.25rem auto .8rem;
    padding:0;
    max-width:640px;
  }

  .info-card{
    background:transparent;
    border:none;
    padding:.35rem 0;
    margin:0;
    text-align:center;
  }

  .info-card h3{
    font-size:.98rem;
    margin:0 0 .25rem;
    color:#2563eb;
    font-weight:700;
  }

  .card-icon{display:none}

  /* İçerik okunurluğu için paragrafları sol hizada bırakıyorum,
     başlıklar ve meta ortalı; istersen tüm metni ortalayabilirim. */
  .content-sections .main-content,
  .content-sections .content-section{
    background:transparent;
    padding:0;
    margin:0 0 1rem;
    font-size:1rem;
    line-height:1.7;
    color:rgba(15,23,42,.92);
    margin-left:auto;
    margin-right:auto;
    max-width:720px;
    text-align:left;
  }

  .content-sections h2{
    font-size:1.02rem;
    margin:.45rem 0;
    color:#2563eb;
    font-weight:700;
    text-align:center;
  }

  .section-content{
    padding-left:.12rem;
    color:rgba(255, 255, 255, 0.9);
    text-align:left;
  }

  .entry-content{
    padding:0;
    margin:0 auto;
    max-width:720px;
  }

  .entry-content img{
    max-width:100%;
    height:auto;
    border-radius:8px;
    display:block;
    margin:.6rem auto; /* görsel ortalı */
  }

  .entry-content pre,
  .entry-content code{
    white-space:pre-wrap;
    word-break:break-word;
    background:#f6f8fa;
    padding:.6rem;
    border-radius:8px;
    font-size:.9rem;
    overflow-x:auto;
  }

  /* share & meta bölümü sade ve ortalı, border kaldırıldı */
  .entry-meta.entry-meta-bottom{
    display:flex;
    flex-direction:column;
    justify-content:center;
    gap:.5rem;
    align-items:center;
    padding-top:.6rem;
    border-top:none; /* border yok */
    margin-top:.6rem;
  }

  .date-author{
    font-size:.9rem;
    color:rgba(15,23,42,.7);
    text-align:center;
  }

  .entry-share{
    width:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:.5rem;
    padding:0;
  }

  /* share butonları basit: gölgelik, kenarlık yok, düz renk */
  .entry-share .btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:.42rem .6rem;
    border-radius:8px;
    background:transparent;
    color:#2563eb;
    text-decoration:none;
    font-size:.92rem;
    box-shadow:none;
    border:1px solid transparent; /* tamamen bordersız isteğine uygun */
  }

  /* eğer bir ana (primary) buton istersen, bu sınıfı kullan */
  .entry-share .btn.primary{
    background:#2563eb;
    color:#fff;
    box-shadow:none;
  }

  .post-content,
  .entry-content{padding:0}
  .single-page-area .post{padding:0}
  a.btn,a.url.fn.n{touch-action:manipulation}
  .entry-content *{max-width:100%;box-sizing:border-box}
}


    </style>

    <div class="content-area single-page-area">
      <div class="single-page-content">
        <article class="post">
          <!-- Hero Section with Image -->
          <div class="post-hero">
            <% if (posts && posts.image_url) { %>
              <div class="hero-image-container">
                <div class="hero-image-wrapper">
                  <img class="hero-image" src="<%= posts.image_url %>" alt="<%= posts.title || 'post image' %>" loading="lazy">
                </div>
                <div class="hero-overlay"></div>
              </div>
            <% } %>

            <div class="hero-content">
              <div class="hero-meta">
                <span class="hero-date">
                  <i class="far fa-calendar-alt"></i> <%= prettyDate(posts && posts.updatedAt) %>
                </span>
              </div>
            </div>
          </div>

          <!-- Yazı Başlığı ve Meta -->
          <div class="post-content">
            <!-- Post Header -->
            <header class="entry-header">
              <h1 class="entry-title"><%= posts && posts.title || 'Başlık yok' %></h1>
            </header>


              <!-- Main Content -->
              <div class="content-sections">
                <% if (posts && posts.content) { %>
                  <section class="main-content">
                    <%- posts.content %>
                  </section>
                <% } %>


            <!-- Alt Meta ve Paylaşım -->
            <div class="entry-meta entry-meta-bottom">
              <div class="date-author">
                <span class="entry-date">
                  <a href="/blog/<%= posts && posts.id %>" rel="bookmark">
                    <i class="far fa-clock"></i> <span class="entry-date"><%= prettyDate(posts && posts.updatedAt) %></span>
                  </a>
                </span>
                <span class="author vcard">
                  <a class="url fn n" href="/blog/<%= posts && posts.id %>" rel="author">
                    <i class="fas fa-user"></i> Baran Çelik
                  </a>
                </span>
              </div>

              <div class="entry-share btn-group share-buttons">
                <a href="/blog/<%= posts && posts.id %>" onclick="window.open(this.href,'','menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=300,width=600');return false;" class="btn" target="_blank" title="Share on Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="/blog/<%= posts && posts.id %>" onclick="window.open(this.href,'','menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=300,width=600');return false;" class="btn" target="_blank" title="Share on Twitter"><i class="fab fa-twitter"></i></a>
                <a href="/blog/<%= posts && posts.id %>" onclick="window.open(this.href,'','menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=600,width=600');return false;" class="btn" title="Share on LinkedIn"><i class="fab fa-linkedin-in"></i></a>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>


      </div>
    </div>
    <script data-cfasync="false" src="../../../../cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script src="/js/jquery-2.1.3.min.js"></script>
    <script src="/js/modernizr.custom.js"></script>
    <script src="/js/animating.js"></script>

    <script src="/js/imagesloaded.pkgd.min.js"></script>
    <script src='https://www.google.com/recaptcha/api.js'></script>

    <script src='/js/perfect-scrollbar.min.js'></script>
    <script src='/js/jquery.shuffle.min.js'></script>
    <script src='/js/masonry.pkgd.min.js'></script>
    <script src='/js/owl.carousel.min.js'></script>
    <script src="/js/jquery.magnific-popup.min.js"></script>

    <script src="/js/validator.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>
