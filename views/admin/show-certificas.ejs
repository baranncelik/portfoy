<%- include("../partials/topbar") %>
<link rel="stylesheet" href="/css/auth.css">
</head>
<body>
<%- include("../partials/navbar") %>

<div class="page-content">
    <div class="container">
        <div class="content-wrapper">
            <div class="content-card">
                <div class="header-actions">
                    <h2 class="section-title">Sertifikalar</h2>
                    <a href="/admin/add-certifica" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Yeni Sertifika Ekle
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Başlık</th>
                                <th>Açıklama</th>
                                <th>PDF</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (certificas && certificas.length > 0) { %>
                                <% certificas.forEach(certifica => { %>
                                    <tr>
                                        <td><%= certifica.title %></td>
                                        <td>
                                            <div class="description-cell">
                                                <%= certifica.description %>
                                            </div>
                                        </td>
                                        <td>
                                            <% if(certifica.pdf) { %>
                                                <a href="<%= certifica.pdf %>" target="_blank" class="pdf-link">
                                                    <i class="fas fa-file-pdf"></i> Görüntüle
                                                </a>
                                            <% } else { %>
                                                <span class="no-pdf">PDF Yok</span>
                                            <% } %>
                                        </td>
                                        <td class="actions-cell">
                                            <a href="/admin/edit-certifica/<%= certifica.id %>" class="btn btn-edit">
                                                <i class="fas fa-edit"></i> Düzenle
                                            </a>
                                            <form action="/admin/delete-certifica/<%= certifica.id %>" method="POST" class="delete-form">
                                                <button type="submit" class="btn btn-delete" onclick="return confirm('Bu sertifikayı silmek istediğinize emin misiniz?')">
                                                    <i class="fas fa-trash"></i> Sil
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="no-data">
                                        <div class="no-data-message">
                                            <i class="fas fa-info-circle"></i>
                                            <p>Henüz sertifika eklenmemiş.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>body {
    margin: 0;
    font-family: 'Inter', sans-serif;
    background-color: #f8f9fa; /* sayfa arka planı */
}

.page-content {
    display: flex;
    justify-content: center; /* yatay ortala */
    align-items: center;     /* dikey ortala */
    min-height: 100vh;       /* ekran yüksekliği kadar */
    padding: 2rem;
}

.container {
    width: 100%;
    max-width: 1000px; /* istersen büyütebilirsin */
}

.content-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
}

.content-card {
    background-color: #ffffff; /* form / card beyaz */
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    width: 100%;
}

/* Header ve butonlar */
.header-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
}

.section-title {
    margin: 0;
    font-size: 1.8rem;
    color: #333;
}

/* Table responsive */
.table-responsive {
    overflow-x: auto;
}

.table {
    width: 100%;
    border-collapse: collapse;
}

.table th, .table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid #dee2e6;
}

.table th {
    background-color: #f8f9fa;
    color: #495057;
    font-weight: 600;
}

/* Description hücresi */
.description-cell {
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Actions hücresi */
.actions-cell {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
}

/* Butonlar */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
    text-decoration: none;
}

.btn-primary {
    background-color: #007bff;
    color: #fff;
}

.btn-primary:hover {
    background-color: #0056b3;
}

.btn-edit {
    background-color: #28a745;
    color: #fff;
}

.btn-edit:hover {
    background-color: #218838;
}

.btn-delete {
    background-color: #dc3545;
    color: #fff;
}

.btn-delete:hover {
    background-color: #c82333;
}

.pdf-link {
    color: #007bff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.pdf-link:hover {
    color: #0056b3;
}

.no-pdf {
    color: #6c757d;
    font-style: italic;
}

.no-data-message {
    text-align: center;
    color: #6c757d;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem;
}

.no-data-message i {
    font-size: 2rem;
}

/* Responsive ayarlar */
@media (max-width: 768px) {
    .header-actions {
        flex-direction: column;
        gap: 1rem;
        align-items: stretch;
    }

    .actions-cell {
        flex-direction: column;
        gap: 0.5rem;
    }

    .description-cell {
        max-width: 150px;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }
}

</style>

</body>
</html>