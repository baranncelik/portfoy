<%- include("../partials/topbar") %>

  <style>

    .main{margin-left:var(--sidebar-width);padding:28px;min-height:100vh;transition:margin .25s}
    .card{background:#fff;border-radius:12px;padding:20px;box-shadow:0 8px 30px rgba(2,6,23,0.06)}
    .section-title{font-size:20px;font-weight:700;color:#0f172a;margin-bottom:6px}
    @media (max-width: 768px){ .topbar{display:flex} .sidebar{transform:translateX(-110%);box-shadow:0 12px 30px rgba(2,6,23,0.12)} .sidebar.open{transform:translateX(0)} .main{margin-left:0;padding:84px 16px 24px} }
    .preview-img{max-height:140px;border-radius:8px;margin-top:10px;object-fit:cover;border:1px solid #e6e6e6}
    label.inline { display:inline-flex; align-items:center; gap:8px }
    .input, textarea { width:100%; padding:10px; border-radius:8px; border:1px solid #e6e6e6 }
  </style>
</head>
<body>
  <%- include("../partials/navbar") %>


  <div id="overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:1200"></div>

  <main class="main">
    <div class="max-w-3xl mx-auto">
      <div class="card">
        <div class="flex items-center justify-between mb-4">
          <div>
            <div class="section-title">Edit Post</div>
            <p class="text-sm text-gray-600">Postu düzenle ve kaydet.</p>
          </div>
          <div class="hidden sm:flex gap-2">
            <a href="/admin/add-posts" class="px-3 py-2 rounded-md text-sm border border-gray-200 hover:bg-gray-50">Yeni Gönderi Ekle</a>
            <a href="/admin/show-posts" class="px-3 py-2 rounded-md text-sm border border-gray-200 hover:bg-gray-50">My Posts</a>
          </div>
        </div>

        <!-- Edit form -->
        <form action="/admin/edit-post/<%= post.id %>" method="POST" enctype="multipart/form-data">
          <!-- Title -->
          <div class="mb-4">
            <label for="title" class="block text-sm font-semibold text-gray-700 mb-2">Title</label>
            <input id="title" name="title" type="text" required class="input" value="<%= post.title %>">
          </div>

          <!-- Summary / Excerpt -->
          <div class="mb-4">
            <label for="summary" class="block text-sm font-semibold text-gray-700 mb-2">summary (optional)</label>
            <textarea id="summary" name="summary" rows="3" class="input"><%= post.summary %></textarea>
          </div>

        

          <!-- Ana İçerik -->
          <div class="mb-4">
            <label for="content" class="block text-sm font-semibold text-gray-700 mb-2">Ana İçerik</label>
            <textarea id="content" name="content" rows="8" class="input"
                      placeholder="Gönderi ana içeriği..."><%= post.content %></textarea>
          </div>

          <!-- Image -->
          <div class="mb-4">
            <label for="imagw_url" class="block text-sm font-semibold text-gray-700 mb-2">Post Image</label>
            <input id="image_url" name="image_url" type="file" accept="image/*" class="w-full rounded-lg border border-gray-200 px-4 py-3">
            <% if (post && post.image_url) { %>
              <div id="imgPreviewWrap" class="mt-2">
                <img id="imgPreview" class="preview-img" src="<%= post.image_url %>" alt="Preview">
              </div>
            <% } else { %>
              <div id="imgPreviewWrap" class="mt-2 hidden">
                <img id="imgPreview" class="preview-img" src="" alt="Preview">
              </div>
            <% } %>
          </div>

          <!-- Published -->
          <div class="mb-4 flex items-center gap-4">
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input 
                type="checkbox" 
                name="published" 
                class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                value="true"
                <%= post.published === true || post.published === 1 || post.published === '1' ? 'checked' : '' %>
              >
              <span class="text-sm font-medium text-gray-700">Published</span>
            </label>
          </div>

          <!-- Buttons -->
          <div class="flex items-center gap-3">
            <button type="submit" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-3 rounded-lg shadow-sm">Save Changes</button>

            <form action="/admin/delete-post/<%= post.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?');">
              <button type="submit" class="btn-danger">Delete</button>
            </form>
          </div>
        </form>

      </div>
    </div>
  </main>

  <script>
    

    /* Image preview for edit page */
    (function(){
      const fileInput = document.getElementById('image_url');
      const previewWrap = document.getElementById('imgPreviewWrap');
      const previewImg = document.getElementById('imgPreview');

      if (!fileInput || !previewWrap || !previewImg) return;

      fileInput.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (!file) { previewWrap.classList.add('hidden'); previewImg.removeAttribute('src'); return; }
        if (!file.type.startsWith('image/')) { alert('Please select an image file.'); return; }
        const reader = new FileReader();
        reader.onload = ev => {
          previewImg.src = ev.target.result;
          previewWrap.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
      });
    })();
  </script>
  <script src="https://cdn.tiny.cloud/1/j7gcco89bx6op2sbuiy5d9nehemvb3xe5wh8iqtmllj94g87/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
  tinymce.init({
    selector: '#content',
    plugins: 'link lists table code image media',
    toolbar: 'undo redo | styles | bold italic underline | bullist numlist | link image media | table | code',
    menubar: false,
    branding: false,
    height: 400
  });
</script>
</body>
</html>
