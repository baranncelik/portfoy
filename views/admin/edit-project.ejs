<%- include("../partials/topbar") %>

    <style>
        .main{margin-left:var(--sidebar-width);padding:28px;min-height:100vh;transition:margin .25s}
        .card{background:#fff;border-radius:12px;padding:20px;box-shadow:0 8px 30px rgba(2,6,23,0.06)}
        .section-title{font-size:20px;font-weight:700;color:#0f172a;margin-bottom:6px}
        @media (max-width: 768px){ .topbar{display:flex} .sidebar{transform:translateX(-110%);box-shadow:0 12px 30px rgba(2,6,23,0.12)} .sidebar.open{transform:translateX(0)} .main{margin-left:0;padding:84px 16px 24px} }
        .preview-img{max-height:140px;border-radius:8px;margin-top:10px;object-fit:cover;border:1px solid #e6e6e6}
        label.inline { display:inline-flex; align-items:center; gap:8px }
        .input, textarea { width:100%; padding:10px; border-radius:8px; border:1px solid #e6e6e6 }
    </style>
</head>
<body>
    <%- include("../partials/navbar") %>

    <div id="overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:1200"></div>

    <main class="main">
        <div class="max-w-3xl mx-auto">
            <div class="card">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <div class="section-title">Edit Project</div>
                        <p class="text-sm text-gray-600">Projeyi düzenle ve kaydet.</p>
                    </div>
                    <div class="hidden sm:flex gap-2">
                        <a href="/admin/add-projects" class="px-3 py-2 rounded-md text-sm border border-gray-200 hover:bg-gray-50">Yeni Proje Ekle</a>
                        <a href="/admin/show-projects" class="px-3 py-2 rounded-md text-sm border border-gray-200 hover:bg-gray-50">Projelerim</a>
                    </div>
                </div>

                <!-- Edit form -->
                <form action="/admin/edit-project/<%= project.id %>" method="POST" enctype="multipart/form-data">
                    <!-- Title -->
                    <div class="mb-4">
                        <label for="project_title" class="block text-sm font-semibold text-gray-700 mb-2">Title</label>
                        <input id="project_title" name="project_title" type="text" required class="input" value="<%= project.project_title %>">
                    </div>


                    <!-- Content -->
                    <div class="mb-4">
                        <label for="project_description" class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
                        <textarea id="project_description" name="project_description" rows="8" class="input"><%= project.project_description %></textarea>
                    </div>

                    <div class="mb-4">
                        <label for="link" class="block text-sm font-semibold text-gray-700 mb-2">Link</label>
                        <textarea id="link" name="link" rows="8" class="input"><%= project.link %></textarea>
                    </div>

                    <div class="mb-4">
                        <label for="repo_link" class="block text-sm font-semibold text-gray-700 mb-2">Repo Link</label>
                        <textarea id="repo_link" name="repo_link" rows="8" class="input"><%= project.repo_link %></textarea>
                    </div>

                    <!-- Image -->
                    <div class="mb-4">
                        <label for="img_url" class="block text-sm font-semibold text-gray-700 mb-2">Project Image</label>
                        <input id="img_url" name="img_url" type="file" accept="image/*" class="w-full rounded-lg border border-gray-200 px-4 py-3">
                        <% if (project && project.img_url) { %>
                            <div id="imgPreviewWrap" class="mt-2">
                                <img id="imgPreview" class="preview-img" src="<%= project.img_url %>" alt="Preview">
                            </div>
                        <% } else { %>
                            <div id="imgPreviewWrap" class="mt-2 hidden">
                                <img id="imgPreview" class="preview-img" src="" alt="Preview">
                            </div>
                        <% } %>
                    </div>



                    <!-- Buttons -->
                    <div class="flex items-center gap-3">
                        <button type="submit" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-3 rounded-lg shadow-sm">Save Changes</button>

                        <form action="/admin/delete-project/<%= project.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this project?');">
                            <button type="submit" class="btn-danger">Delete</button>
                        </form>
                    </div>
                </form>

            </div>
        </div>
    </main>

    <script>
        /* Image preview for edit page */
        (function(){
            const fileInput = document.getElementById('img_url');
            const previewWrap = document.getElementById('imgPreviewWrap');
            const previewImg = document.getElementById('imgPreview');

            if (!fileInput || !previewWrap || !previewImg) return;

            fileInput.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) { previewWrap.classList.add('hidden'); previewImg.removeAttribute('src'); return; }
                if (!file.type.startsWith('image/')) { alert('Please select an image file.'); return; }
                const reader = new FileReader();
                reader.onload = ev => {
                    previewImg.src = ev.target.result;
                    previewWrap.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            });
        })();
    </script>
</body>
</html>
